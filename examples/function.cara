SET x 10

FUNC my_func [
    SET x 50
    FORWARD x
]

CALL my_func
RIGHT 90
FORWARD x

FUNC square size col [
    COLOR col
    REPEAT 4 [
        FORWARD size
        RIGHT 90
    ]
]

CALL square 50 "red"
CALL square 100 "blue"

FUNC calculate_offset size [
    SET result size * 2 + 10
    RETURN result
]

SET base_dist 50
FORWARD (CALL calculate_offset base_dist)
